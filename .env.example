
APP_NAME=AI Financial Analyst
APP_VERSION=0.1.0
ENVIRONMENT=development

# Run with synthetic fixtures and no network/LLM calls.
# Set to false (or remove) to use real SEC/market data and a real LLM.
DEMO_MODE=false
DEBUG=false



OPENAI_API_KEY=sk-your-openai-key-here
FMP_API_KEY=your-fmp-api-key-here



LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_TO_CONSOLE=true

API_TIMEOUT=30
API_MAX_RETRIES=3
API_RETRY_BACKOFF=0.5

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096


EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Cross-encoder reranking improves ordering precision at the cost of one
# extra model forward pass over the candidate pool.
ENABLE_RERANKER=true
# Tuned with scripts/retrieval_sweep.py. A higher floor discards candidates
# the cross-encoder would otherwise promote.
RETRIEVAL_MIN_SIMILARITY=0.15
VECTOR_TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200


SANDBOX_TIMEOUT=30
SANDBOX_MEMORY_LIMIT_MB=512

AUTH_ENABLED=true

AUTH_SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=60

AUTH_DATABASE_URL=sqlite:///./data/auth.db





EDGAR_IDENTITY=your-name your-email@example.com

MARKET_PRIMARY_PROVIDER=yahoo
MARKET_FALLBACK_PROVIDERS=fmp
MARKET_FALLBACK_ENABLED=true
MARKET_PROVIDER_TIMEOUT_SECONDS=10
MARKET_PROVIDER_MAX_ATTEMPTS=2
MARKET_QUOTE_TTL_SECONDS=60
MARKET_CACHE_STALE_SECONDS=900
MARKET_CACHE_MAX_ENTRIES=1024

RISK_FREE_RATE=0.0425
MARKET_RETURN=0.10
COST_OF_DEBT=0.05
TAX_RATE=0.21
TERMINAL_GROWTH=0.03
PROJECTION_YEARS=5


QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=financial_documents
