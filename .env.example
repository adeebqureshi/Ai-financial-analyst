# ════════════════════════════════════════════════════════════════════════════
# AI Financial Analyst — Environment Configuration
# ════════════════════════════════════════════════════════════════════════════
# Copy this file to `.env` and fill in the required values.
# All variables are case-insensitive and have sensible defaults for
# local development. See `app/core/config.py` for full documentation.
# ════════════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=AI Financial Analyst
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# ── API Keys (required in production) ────────────────────────────────────────
OPENAI_API_KEY=
SEC_API_KEY=
FMP_API_KEY=

# ── Logging ─────────────────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_TO_CONSOLE=true

# ── API / Network ────────────────────────────────────────────────────────────
API_TIMEOUT=30
API_MAX_RETRIES=3
API_RETRY_BACKOFF=0.5

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# ── Retrieval / Vector Store ─────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── Sandbox ──────────────────────────────────────────────────────────────────
SANDBOX_TIMEOUT=30
SANDBOX_MEMORY_LIMIT_MB=512