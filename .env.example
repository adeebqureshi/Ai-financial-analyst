# ════════════════════════════════════════════════════════════════════════════
# AI Financial Analyst — Environment Configuration Template
# ════════════════════════════════════════════════════════════════════════════
# Copy this file to `.env` and fill in the required values.
# All variables are case-insensitive and have sensible defaults for
# local development. See `app/core/config.py` for full documentation.
# ════════════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=AI Financial Analyst
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# ── Demo Mode ────────────────────────────────────────────────────────────────
# Set to true to enable deterministic demo mode with synthetic data.
# This allows demonstrating the application without any external API credentials.
# DEMO_MODE=false

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins for production/staging.
# REQUIRED when ENVIRONMENT=production.
# Example: https://app.example.com,https://www.example.com
# In development/test, localhost origins are allowed automatically.
# CORS_ORIGINS=https://app.example.com,https://www.example.com

# ── API Keys (required in production) ────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
FMP_API_KEY=your-fmp-api-key-here

# Optional: SEC API key for financial data enrichment.
# SEC_API_KEY=your-sec-api-key-here

# Optional: enables layout-aware Markdown PDF parsing via LlamaParse.
# Without it, ingestion falls back to Marker (if installed) then PyMuPDF.
# LLAMA_PARSE_API_KEY=llx-your-key-here

# ── Logging ─────────────────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_TO_CONSOLE=true

# ── API / Network ────────────────────────────────────────────────────────────
API_TIMEOUT=30
API_MAX_RETRIES=3
API_RETRY_BACKOFF=0.5

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# ── Retrieval / Vector Store ─────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Optional: run the cross-encoder reranker after hybrid retrieval (default: false).
# ENABLE_RERANKER=false

# ── Sandbox ──────────────────────────────────────────────────────────────────
SANDBOX_TIMEOUT=30
SANDBOX_MEMORY_LIMIT_MB=512

# ── Authentication / Authorization ───────────────────────────────────────────
# Require authentication on business endpoints (secure default: true).
# Set to false only for trusted local development without login.
AUTH_ENABLED=true

# REQUIRED in production: secret used to sign JWT access tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=

# Access token lifetime in minutes (1-1440).
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SQLAlchemy URL for the user account store. SQLite by default;
# use PostgreSQL in production, e.g. postgresql+psycopg://user:pass@host/db
AUTH_DATABASE_URL=sqlite:///./data/auth.db

# ── Chat Persistence ──────────────────────────────────────────────────────────
# SQLAlchemy URL for the chat conversation store. SQLite by default for local
# development; use PostgreSQL in production so conversations survive restarts
# and are shared across workers/containers.
# CHAT_DATABASE_URL=sqlite:///./data/chat.db
# CHAT_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/financial

# Optional Redis URL used to cache recent chat session context. When Redis is
# unavailable the store transparently falls back to the database.
# CHAT_REDIS_URL=redis://localhost:6379/1

# Retention window (days) after which idle chat sessions are purged.
# CHAT_RETENTION_DAYS=30

# ==========================
# SEC EDGAR
# ==========================

EDGAR_IDENTITY=your-name your-email@example.com

# ==========================
# Market Data Providers
# ==========================
# NOTE: Yahoo Finance (via yfinance) is the default PRIMARY provider. It is an
# unofficial, non-commercial-use data source with NO SLA and may throttle or
# change without notice. For production workloads, point MARKET_PRIMARY_PROVIDER
# at a commercial vendor (implement a MarketDataProvider subclass and register it
# in app.ingestion.services.market_service._REGISTRY).
#
# Fallback: FMP (Financial Modeling Prep) is the default secondary provider.
# It requires an FMP_API_KEY (free tier available). When no key is set, the
# fallback fails fast and the service reports the price as unavailable rather
# than fabricating a value.
MARKET_PRIMARY_PROVIDER=yahoo
MARKET_FALLBACK_PROVIDERS=fmp
MARKET_FALLBACK_ENABLED=true
MARKET_PROVIDER_TIMEOUT_SECONDS=10
MARKET_PROVIDER_MAX_ATTEMPTS=2
MARKET_QUOTE_TTL_SECONDS=60
MARKET_CACHE_STALE_SECONDS=900
MARKET_CACHE_MAX_ENTRIES=1024
# Quote cache backend: 'auto' (Redis when reachable, else in-process), 'redis', 'memory'
MARKET_CACHE_BACKEND=auto

# ==========================
# Financial Assumptions (valuation inputs)
# ==========================
# These are the canonical macro inputs to DCF/WACC valuation. They are
# explicit assumptions, NOT live market data. Provenance (source and
# as-of date) is surfaced in valuation results.
RISK_FREE_RATE=0.0425
MARKET_RETURN=0.10
COST_OF_DEBT=0.05
TAX_RATE=0.21
TERMINAL_GROWTH=0.03
PROJECTION_YEARS=5


# ==========================
# Database (for production)
# ==========================

# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/financial_analyst
# REDIS_URL=redis://localhost:6379/0

# ==========================
# Vector Store
# ==========================

# CHROMA_PERSIST_DIRECTORY=./storage/chroma
# QDRANT_URL=http://localhost:6333